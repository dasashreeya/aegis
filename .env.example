# =============================================================================
# AEGIS  ·  environment template
# =============================================================================
# Copy to .env and fill in. Nothing here is read at runtime on Cloud Run: the
# Terraform in infra/ sets these as service environment variables and the
# attached service account replaces the key file below.
#
#   cp .env.example .env
#
# Every variable is optional. With an empty .env the fleet runs in mock mode:
# no network, no spend, no credentials, and the test suite passes.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. Runtime mode
# -----------------------------------------------------------------------------
# mock   : no network, no spend. Deterministic re-adjudication, local shield,
#          in-process traces. The default, and what CI runs.
# cached  : reserved for replaying recorded provider responses.
# live   : real Vertex AI, real hosted Model Armor, real Cloud Trace. Costs money.
AEGIS_MODE=mock

# debug | info | warning | error
AEGIS_LOG_LEVEL=info

# Reported on /api/health and stamped into every trace.
AEGIS_ENVIRONMENT=development


# -----------------------------------------------------------------------------
# 2. Google Cloud
# -----------------------------------------------------------------------------
AEGIS_GOOGLE_CLOUD_PROJECT=
AEGIS_GOOGLE_CLOUD_LOCATION=us-central1

# Local development only. On Cloud Run leave this unset and use the attached
# identity. Aegis copies it into GOOGLE_APPLICATION_CREDENTIALS for google-auth.
AEGIS_GOOGLE_APPLICATION_CREDENTIALS=

# Vertex AI rather than the public Gemini endpoint.
AEGIS_USE_VERTEXAI=true


# -----------------------------------------------------------------------------
# 3. Re-adjudication model
# -----------------------------------------------------------------------------
# Advisory only. The Z3 result holds the verdict; the model writes the rationale
# and may escalate, but it can never clear a flag. See app/agents/adjudicator.py.
AEGIS_MODEL_ADJUDICATOR=gemini-2.5-flash
AEGIS_ADJUDICATOR_TEMPERATURE=0.0
AEGIS_ADJUDICATOR_MAX_OUTPUT_TOKENS=4096
AEGIS_ADJUDICATOR_TIMEOUT_SECONDS=45


# -----------------------------------------------------------------------------
# 4. Fleet runtime
# -----------------------------------------------------------------------------
# auto  : ADK SequentialAgent when google-adk is installed, in process otherwise.
# adk   : require ADK; fail loudly if it is missing.
# local : never use ADK. Same seven steps, same ledger, no dependency.
AEGIS_FLEET_RUNTIME=auto
AEGIS_FLEET_APP_NAME=aegis


# -----------------------------------------------------------------------------
# 5. Shields
# -----------------------------------------------------------------------------
# Bare template id or a full projects/../locations/../templates/.. name.
# Empty means the local pattern shield only. `terraform output model_armor_template`
AEGIS_MODEL_ARMOR_TEMPLATE=
AEGIS_MODEL_ARMOR_LOCATION=us-central1

# If a configured hosted template cannot be reached, refuse the decision rather
# than process it unscreened.
AEGIS_MODEL_ARMOR_FAIL_CLOSED=true


# -----------------------------------------------------------------------------
# 6. Storage
# -----------------------------------------------------------------------------
# memory | firestore
AEGIS_STORAGE_BACKEND=memory
AEGIS_FIRESTORE_COLLECTION_DECISIONS=decisions
AEGIS_FIRESTORE_COLLECTION_LEDGER=decision_ledger


# -----------------------------------------------------------------------------
# 7. Async plane
# -----------------------------------------------------------------------------
AEGIS_PUBSUB_TOPIC=aegis-decisions


# -----------------------------------------------------------------------------
# 8. Telemetry
# -----------------------------------------------------------------------------
# auto | cloud | memory | console | none
# auto resolves to cloud in live mode with a project set, memory otherwise.
AEGIS_TRACE_EXPORTER=auto
AEGIS_TRACE_SAMPLE_RATIO=1.0
AEGIS_SERVICE_NAME=aegis-api
